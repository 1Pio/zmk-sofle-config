#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include "keys_de.h"

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers { compatible = "zmk,conditional-layers"; };

    behaviors {
        DTapPlay: DTapPlay {
            compatible = "zmk,behavior-tap-dance";
            label = "DTAPPLAY";
            #binding-cells = <0>;
            bindings = <&kp C_PLAY_PAUSE>, <&kp C_NEXT>, <&kp C_PREVIOUS>;
        };

        hTapMomentaryLayer: hTapMomentaryLayer {
            compatible = "zmk,behavior-hold-tap";
            label = "HTAPMOMENTARYLAYER";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <230>;
            hold-while-undecided;
        };

        cmd_to_mt: cmd_to_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "CMD_TO_MT";
            bindings = <&kp>, <&base_rgb>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            flavor = "hold-preferred";
            hold-while-undecided;
            hold-while-undecided-linger;
        };

        lower_rgb_layer: lower_rgb_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "LOWER_RGB_LAYER";
            bindings = <&lower_rgb_mo>, <&lower_rgb_to>;

            #binding-cells = <2>;
            tapping-term-ms = <230>;
            hold-while-undecided;
        };

        raise_rgb_layer: raise_rgb_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "RAISE_RGB_LAYER";
            bindings = <&raise_rgb_mo>, <&raise_rgb_to>;

            #binding-cells = <2>;
            tapping-term-ms = <230>;
            hold-while-undecided;
        };

        adjust_rgb_layer: adjust_rgb_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "ADJUST_RGB_LAYER";
            bindings = <&adjust_rgb_mo>, <&adjust_rgb_to>;

            #binding-cells = <2>;
            tapping-term-ms = <230>;
            hold-while-undecided;
        };
    };

    macros {
        Super: Super {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_CONTROL &kp LEFT_SHIFT &kp LEFT_ALT>;
            label = "SUPER";
        };

        cmd_to: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LEFT_COMMAND>;
            label = "NEW_MACRO";
        };

        base_rgb: base_rgb {
            compatible = "zmk,behavior-macro";
            label = "BASE_RGB";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_tap>,
                <&to BASE>,
                <&rgb_ug RGB_COLOR_HSB(3,100,2)>,
                <&rgb_ug RGB_EFS_CMD 0>;
        };

        lower_rgb_to: lower_rgb_to {
            compatible = "zmk,behavior-macro";
            label = "LOWER_RGB_TO";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_tap>,
                <&to LOWER>,
                <&rgb_ug RGB_COLOR_HSB(3,100,25)>,
                <&rgb_ug RGB_EFS_CMD 0>;
        };

        lower_rgb_mo: lower_rgb_mo {
            compatible = "zmk,behavior-macro";
            label = "LOWER_RGB_MO";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&mo LOWER>,
                <&macro_tap>,
                <&rgb_ug RGB_COLOR_HSB(3,100,25)>,
                <&rgb_ug RGB_EFS_CMD 0>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo LOWER>,
                <&macro_tap>,
                <&rgb_ug RGB_COLOR_HSB(3,100,2)>,
                <&rgb_ug RGB_EFS_CMD 0>;
        };

        raise_rgb_to: raise_rgb_to {
            compatible = "zmk,behavior-macro";
            label = "RAISE_RGB_TO";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_tap>,
                <&to RAISE>,
                <&rgb_ug RGB_COLOR_HSB(6,100,10)>,
                <&rgb_ug RGB_EFS_CMD 0>;
        };

        raise_rgb_mo: raise_rgb_mo {
            compatible = "zmk,behavior-macro";
            label = "RAISE_RGB_MO";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&mo RAISE>,
                <&macro_tap>,
                <&rgb_ug RGB_COLOR_HSB(6,100,10)>,
                <&rgb_ug RGB_EFS_CMD 0>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo RAISE>,
                <&macro_tap>,
                <&rgb_ug RGB_COLOR_HSB(3,100,2)>,
                <&rgb_ug RGB_EFS_CMD 0>;
        };

        adjust_rgb_to: adjust_rgb_to {
            compatible = "zmk,behavior-macro";
            label = "ADJUST_RGB_TO";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_tap>,
                <&to ADJUST>,
                <&rgb_ug RGB_COLOR_HSB(30,95,7)>,
                <&rgb_ug RGB_EFS_CMD 0>;
        };

        adjust_rgb_mo: adjust_rgb_mo {
            compatible = "zmk,behavior-macro";
            label = "ADJUST_RGB_MO";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&mo ADJUST>,
                <&macro_tap>,
                <&rgb_ug RGB_COLOR_HSB(30,95,7)>,
                <&rgb_ug RGB_EFS_CMD 0>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo ADJUST>,
                <&macro_tap>,
                <&rgb_ug RGB_COLOR_HSB(3,100,2)>,
                <&rgb_ug RGB_EFS_CMD 0>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "(  )";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  | PLAY  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESCAPE      &kp N1    &kp N2            &kp N3        &kp N4                     &kp N5                                   &kp N6                   &kp N7                   &kp N8                     &kp N9                  &kp N0                      &mt DE_DOUBLE_QUOTES DE_ACUTE
&kp TAB         &kp DE_Q  &kp DE_W          &kp DE_E      &kp DE_R                   &kp DE_T   &kp DE_Z                                               &kp DE_U                 &kp DE_I                   &kp DE_O                &kp DE_P                    &kp DE_U_UMLAUT
&kp LEFT_SHIFT  &kp DE_A  &kp DE_S          &kp DE_D      &kp DE_F                   &kp DE_G   &kp DE_H                                               &kp DE_J                 &kp DE_K                   &kp DE_L                &kp DE_O_UMLAUT             &kp DE_A_UMLAUT
&kp LEFT_SHIFT  &kp DE_Y  &kp DE_X          &kp DE_C      &kp DE_V                   &kp DE_B   &kp LS(F11)     &DTapPlay     &kp DE_N              &kp DE_M              &mt DE_SEMICOLON DE_COMMA  &mt DE_COLON DE_PERIOD  &mt DE_UNDERSCORE DE_MINUS  &kp BACKSPACE
                          &kp LEFT_CONTROL  &kp LEFT_ALT  &cmd_to_mt LEFT_COMMAND 0  &kp SPACE  &kp LEFT_SHIFT  &kp CAPSLOCK  &lower_rgb_layer 0 0  &raise_rgb_layer 0 0  &adjust_rgb_layer 0 0      &kp RIGHT_ALT
            >;
        };

        raise_layer {
            display-name = "( 1 )";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&trans                    &kp F1            &kp F2            &kp F3          &kp F4           &kp F5                                              &kp F6    &kp F7          &kp F8        &kp F9         &kp F10        &kp F11
&kp LS(LA(LC(DE_CARET)))  &kp TAB           &msc MOVE_X(-10)  &mmv MOVE_UP    &msc MOVE_X(10)  &msc SCRL_DOWN  &mkp MB1                                      &mkp MCLK       &mkp MB2      &kp BACKSPACE  &kp BACKSPACE  &kp F12
&trans                    &msc MOVE_Y(-20)  &mmv MOVE_LEFT    &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_UP    &kp LEFT_ARROW                                &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT      &kp ENTER      &kp DEL
&trans                    &msc MOVE_Y(20)   &mkp MB4          &mkp MB3        &mkp MB5         &kp CAPS        &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &mkp MB4  &kp PAGE_DOWN   &kp PAGE_UP   &mkp MB5       &kp DELETE     &trans
                                            &trans            &trans          &trans           &base_rgb       &trans             &kp RIGHT_ALT    &base_rgb  &trans          &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };

        lower_layer {
            display-name = "( 2 )";

            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&trans        &kp LS(F1)    &kp LS(F2)          &kp LS(F3)           &kp LS(F4)            &kp LS(F5)                                                 &kp LS(F6)            &kp LS(F7)               &kp LS(F8)                &kp LS(F9)       &kp LS(F10)    &kp LS(F11)
&kp DE_CARET  &kp ESCAPE    &kp DE_EXCLAMATION  &kp DE_QUESTION      &kp DE_AT             &kp DE_PERCENT         &kp DE_AMPERSAND                                          &kp DE_LESS_THAN         &kp DE_GREATER_THAN       &kp DE_SLASH     &kp BACKSPACE  &kp LS(F12)
&trans        &kp TAB       &kp DE_EQUAL        &kp DE_SINGLE_QUOTE  &kp DE_DOUBLE_QUOTES  &kp DE_ACUTE           &kp DE_LEFT_BRACKET                                       &kp DE_LEFT_PARENTHESIS  &kp DE_RIGHT_PARENTHESIS  &kp DE_ASTERISK  &kp ENTER      &kp DELETE
&trans        &kp DE_TILDE  &kp DE_MINUS        &kp DE_PLUS          &kp DE_HASH           &mt DE_EURO DE_DOLLAR  &trans               &kp C_MUTE     &kp DE_RIGHT_BRACKET  &kp DE_LEFT_BRACE        &kp DE_RIGHT_BRACE        &kp DE_SZ        &kp PIPE       &kp DE_BACKSLASH
                            &trans              &trans               &trans                &base_rgb              &trans               &kp RIGHT_ALT  &trans                &base_rgb                &trans                    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            display-name = "( 3 )";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                              &trans           &trans           &trans           &trans           &trans         &trans
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF  &kp DE_PLUS                               &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp BACKSPACE  &trans
&trans             &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &kp DE_SLASH     &kp DE_ASTERISK  &kp DE_MINUS     &kp DE_EQUAL                              &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ENTER      &kp DELETE
&trans             &trans           &trans           &trans           &trans           &trans           &rgb_ug RGB_TOG  &trans  &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp DELETE     &trans
                                    &trans           &trans           &trans           &base_rgb        &trans           &trans  &lower_rgb_to    &trans           &base_rgb        &trans
            >;
        };
    };
};
