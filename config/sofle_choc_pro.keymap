#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include "keys_de.h"

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 3>;
            then-layer = <4>;
        };
    };

    behaviors {
        DTapPlay: DTapPlay {
            compatible = "zmk,behavior-tap-dance";
            label = "DTAPPLAY";
            #binding-cells = <0>;
            bindings = <&kp C_PLAY_PAUSE>, <&kp C_NEXT>, <&kp C_PREVIOUS>;
        };

        HTapLayer: HTapLayer {
            compatible = "zmk,behavior-hold-tap";
            label = "HTAPLAYER";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <55>;
            flavor = "balanced";
        };

        DTapLayers1m: DTapLayers1m {
            compatible = "zmk,behavior-tap-dance";
            label = "DTAPLAYERS1M";
            #binding-cells = <0>;
            bindings = <&to 3>, <&to 0>;
        };
    };

    macros {
        Super: Super {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_CONTROL &kp LEFT_SHIFT &kp LEFT_ALT>;
            label = "SUPER";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "—";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  | PLAY  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESCAPE      &kp N1    &kp N2            &kp N3        &kp N4            &kp N5                                       &kp N6    &kp N7    &kp N8                     &kp N9                        &kp N0                      &mt DE_DOUBLE_QUOTES DE_ACUTE
&kp TAB         &kp DE_Q  &kp DE_W          &kp DE_E      &kp DE_R          &kp DE_T   &kp DE_Z                                    &kp DE_U  &kp DE_I                   &kp DE_O                      &kp DE_P                    &kp DE_U_UMLAUT
&kp LEFT_SHIFT  &kp DE_A  &kp DE_S          &kp DE_D      &kp DE_F          &kp DE_G   &kp DE_H                                    &kp DE_J  &kp DE_K                   &kp DE_L                      &kp DE_O_UMLAUT             &kp DE_A_UMLAUT
&kp LEFT_SHIFT  &kp DE_Y  &kp DE_X          &kp DE_C      &kp DE_V          &kp DE_B   &kp F11         &DTapPlay         &kp DE_N  &kp DE_M  &mt DE_SEMICOLON DE_COMMA  &mt DE_EXCLAMATION DE_PERIOD  &mt DE_UNDERSCORE DE_MINUS  &kp DE_O_UMLAUT
                          &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_COMMAND  &kp SPACE  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &to 2     &to 1     &kp RIGHT_SHIFT            &kp RIGHT_ALT
            >;
        };

        lower_layer {
            display-name = "( 1 )";

            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&trans        &kp F1        &kp F2              &kp F3               &kp F4                &kp F5                                                     &kp F6                &kp F7                   &kp F8                    &kp F9           &kp F10        &kp F11
&kp DE_CARET  &kp ESCAPE    &kp DE_EXCLAMATION  &kp DE_QUESTION      &kp DE_AT             &kp DE_PERCENT         &kp DE_AMPERSAND                                          &kp DE_LESS_THAN         &kp DE_GREATER_THAN       &kp DE_SLASH     &kp BACKSPACE  &kp F12
&trans        &kp TAB       &kp DE_EQUAL        &kp DE_SINGLE_QUOTE  &kp DE_DOUBLE_QUOTES  &kp DE_ACUTE           &kp DE_LEFT_BRACKET                                       &kp DE_LEFT_PARENTHESIS  &kp DE_RIGHT_PARENTHESIS  &kp DE_ASTERISK  &kp ENTER      &kp DELETE
&trans        &kp DE_TILDE  &kp DE_MINUS        &kp DE_PLUS          &kp DE_HASH           &mt DE_EURO DE_DOLLAR  &trans               &kp C_MUTE     &kp DE_RIGHT_BRACKET  &kp DE_LEFT_BRACE        &kp DE_RIGHT_BRACE        &kp DE_SZ        &kp PIPE       &kp DE_BACKSLASH
                            &trans              &trans               &trans                &to 0                  &trans               &kp RIGHT_ALT  &to 2                 &to 3                    &trans                    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };

        raise_layer {
            display-name = "( 2 )";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&trans  &trans            &trans          &trans          &trans           &trans                                              &trans    &trans          &trans        &trans     &trans         &trans
&trans  &kp INS           &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &msc SCRL_UP    &kp C_AC_BACK                                 &kp C_PREVIOUS  &kp C_NEXT    &trans     &kp BACKSPACE  &trans
&trans  &mmv MOVE_Y(500)  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN  &kp LEFT_ARROW                                &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &kp ENTER      &kp DEL
&trans  &kp K_UNDO        &mkp MB4        &mkp MB3        &mkp MB5         &kp CAPS        &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &mkp MB1  &kp PAGE_DOWN   &kp PAGE_UP   &mkp MB2   &kp DELETE     &trans
                          &trans          &trans          &trans           &to 0           &trans             &trans           &to 1     &trans          &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            display-name = "( 3 )";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                              &trans           &trans           &trans           &trans           &trans         &trans
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF  &kp DE_PLUS                               &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp BACKSPACE  &trans
&trans             &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &kp DE_SLASH     &kp DE_ASTERISK  &kp DE_MINUS     &kp DE_EQUAL                              &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ENTER      &kp DELETE
&trans             &trans           &trans           &trans           &trans           &trans           &rgb_ug RGB_TOG  &trans  &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans         &trans
                                    &trans           &trans           &trans           &to 0            &trans           &trans  &to 2            &trans           &trans           &trans
            >;
        };
    };
};
